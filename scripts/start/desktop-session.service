[Unit]
Description=Start the Droidspaces desktop session
# user@1000.service is the systemd user manager: it provides the session D-Bus
# (/run/user/1000/bus) that gnome-session and other desktop sessions require.
# Without it gnome-session aborts with "No session bus running!".
After=network.target display-manager.service user@1000.service
Wants=user@1000.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=1000
PAMName=login
EnvironmentFile=-/etc/environment
# The user manager starts asynchronously, so its D-Bus socket may not exist yet
# when this unit is reached. Worse, user@UID.service reports "ready" as soon as
# dbus.socket is listening, while the bus daemon (dbus.service) only starts
# afterwards. Waiting for the socket alone is therefore not enough: the session
# can start a few milliseconds too early, exit with status 0, and - because
# Restart=on-failure only restarts on failure - never come back. Wait for the
# bus daemon itself to be active before starting the session.
ExecStartPre=/bin/bash -c 'until [ -S /run/user/1000/bus ]; do sleep 1; done; export XDG_RUNTIME_DIR=/run/user/1000; until systemctl --user is-active --quiet dbus.service; do sleep 1; done'
ExecStart=/usr/local/bin/start-desktop-session
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
