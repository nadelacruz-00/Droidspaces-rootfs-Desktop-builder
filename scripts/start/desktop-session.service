[Unit]
Description=Start the Droidspaces desktop session
# user@1000.service is the systemd user manager: it provides the session D-Bus
# (/run/user/1000/bus) that gnome-session and other desktop sessions require.
# Without it gnome-session aborts with "No session bus running!".
After=network.target display-manager.service user@1000.service
Wants=user@1000.service
# The Anland daemon is started by Droidspaces and may not be able to accept a
# producer connection yet when this unit first runs at boot. gnome-shell then
# logs "Failed to connect to Anland daemon at /run/display.sock", exits, and
# gnome-session exits with status 0. Rate limiting is therefore disabled and the
# session is restarted until the daemon is ready.
StartLimitIntervalSec=0

[Service]
Type=simple
User=1000
PAMName=login
EnvironmentFile=-/etc/environment
# The user manager starts asynchronously, so its D-Bus socket may not exist yet
# when this unit is reached. Wait for the socket: that is the correct readiness
# signal, because dbus.socket activates dbus.service on demand.
# Do NOT wait for dbus.service to be active - it is socket-activated and goes
# inactive again as soon as it is idle, so such a check spins until the start
# timeout and the session never runs.
ExecStartPre=/bin/bash -c 'until [ -S /run/user/1000/bus ]; do sleep 1; done'
ExecStart=/usr/local/bin/start-desktop-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
